pragma language_version >= 0.23;

import CompactStandardLibrary;

/**
 * ============================================================================
 * GATEKEEP: PRIVATE ALLOWLIST ACCESS DAPP (MIDNIGHT NETWORK)
 * ============================================================================
 *
 * PUBLIC LEDGER STATE:
 *   - organizerPublicKey: Bytes<32>
 *   - allowedCommitments: Map<Bytes<32>, Boolean>
 *   - usedNullifiers: Map<Bytes<32>, Boolean>
 *   - memberCount: Uint<32>
 *   - verificationCount: Uint<32>
 *   - gatedResourceHash: Bytes<32>
 *
 * PRIVATE WITNESSES:
 *   - secret: Bytes<32>
 *   - salt: Bytes<32>
 *
 * DISCLOSED VALUES:
 *   - nullifier: Bytes<32>
 * ============================================================================
 */

// Public Ledger State
export ledger organizerPublicKey: Bytes<32>;
export ledger allowedCommitments: Map<Bytes<32>, Boolean>;
export ledger usedNullifiers: Map<Bytes<32>, Boolean>;
export ledger memberCount: Uint<32>;
export ledger verificationCount: Uint<32>;
export ledger gatedResourceHash: Bytes<32>;

// Private member witness input
export struct MemberWitness {
    secret: Bytes<32>;
    salt: Bytes<32>;
}

// Circuit 1: Initialize Contract
export circuit initialize(
    newOrganizerKey: Bytes<32>,
    resourceHash: Bytes<32>
): [] {
    organizerPublicKey = disclose(newOrganizerKey);
    gatedResourceHash = disclose(resourceHash);
    memberCount = 0;
    verificationCount = 0;
}

// Circuit 2: Add Member Commitment
export circuit addMember(
    organizerSecret: Bytes<32>,
    commitment: Bytes<32>
): [] {
    // Calculate organizer authorization hash
    const computedKey = persistentHash<Bytes<32>>(organizerSecret);

    // Verify organizer
    assert(
        computedKey == organizerPublicKey,
        "Unauthorized: caller is not contract organizer"
    );

    // Verify commitment is not empty
    assert(
        commitment != pad(32, "0"),
        "Invalid member commitment"
    );

    // Add commitment to allowlist
    allowedCommitments.insert(disclose(commitment), true);

    // Increment member count
    memberCount = memberCount + 1 as Uint<32>;
}

// Circuit 3: Verify Private Membership Access
export circuit verifyAccess(
    memberProof: MemberWitness,
    domainSeparator: Bytes<32>
): Bytes<32> {

    // 1. Verify secret is not empty
    assert(
        memberProof.secret != pad(32, "0"),
        "Invalid member secret key"
    );

    // 2. Verify salt is not empty
    assert(
        memberProof.salt != pad(32, "0"),
        "Invalid member salt"
    );

    // 3. Calculate member commitment
    const memberCommitment =
        persistentHash<[Bytes<32>, Bytes<32>]>(
            [memberProof.secret, memberProof.salt]
        );

    // 4. Verify membership
    assert(
        allowedCommitments.member(disclose(memberCommitment)),
        "Membership verification failed: Commitment not found in allowlist"
    );

    // 5. Calculate unique nullifier
    const nullifier =
        persistentHash<[Bytes<32>, Bytes<32>]>(
            [memberProof.secret, domainSeparator]
        );

    // 6. Prevent double access
    assert(
        !usedNullifiers.member(disclose(nullifier)),
        "Double access rejected: Nullifier has already been claimed"
    );

    // 7. Record nullifier
    usedNullifiers.insert(disclose(nullifier), true);

    // 8. Increment verification count
    verificationCount = verificationCount + 1 as Uint<32>;

    // 9. Disclose nullifier
    return disclose(nullifier);
}
