pragma language_version >= 0.23;

import CompactStandardLibrary;

/**
 * ============================================================================
 * GATEKEEP: PRIVATE ALLOWLIST ACCESS DAPP (MIDNIGHT NETWORK)
 * ============================================================================
 * PRIVACY SPECIFICATION (PUBLIC VS PRIVATE DATA SPLIT):
 *
 * PUBLIC LEDGER STATE (On-Chain):
 *   - organizerPublicKey: Bytes<32>            -> Authorized Organizer Public Hash
 *   - allowedCommitments: Map<Bytes<32>, Bool> -> Set of allowlisted member commitments
 *   - usedNullifiers: Map<Bytes<32>, Bool>     -> Set of spent nullifiers (double-claim check)
 *   - memberCount: Uint<32>                    -> Public member counter
 *   - verificationCount: Uint<32>              -> Public verified access counter
 *   - gatedResourceHash: Bytes<32>             -> Hash anchor of encrypted gated resource payload
 *
 * PRIVATE WITNESSES (Off-Chain / Proved in ZK):
 *   - secret: Bytes<32>                        -> Member secret invite code (NEVER revealed)
 *   - salt: Bytes<32>                          -> Member salt key
 *
 * DISCLOSED VALUES (Circuit Outputs):
 *   - nullifier: Bytes<32>                     -> Derived nullifier preventing duplicate access claims
 * ============================================================================
 */

// Public Ledger State Maps & Variables
export ledger organizerPublicKey: Bytes<32>;
export ledger allowedCommitments: Map<Bytes<32>, Boolean>;
export ledger usedNullifiers: Map<Bytes<32>, Boolean>;
export ledger memberCount: Uint<32>;
export ledger verificationCount: Uint<32>;
export ledger gatedResourceHash: Bytes<32>;

// Data structure for private member witness input
export struct MemberWitness {
    secret: Bytes<32>;
    salt: Bytes<32>;
}

// Circuit 1: Initialize Contract & Set Organizer + Resource Payload
export circuit initialize(newOrganizerKey: Bytes<32>, resourceHash: Bytes<32>): [] {
    organizerPublicKey = disclose(newOrganizerKey);
    gatedResourceHash = disclose(resourceHash);
    memberCount = 0;
    verificationCount = 0;
}

// Circuit 2: Add Member Commitment to Allowlist (Organizer-only access control)
export circuit addMember(organizerSecret: Bytes<32>, commitment: Bytes<32>): [] {
    // Assert organizer secret authorization
    const computedKey = persistent_hash<Bytes<32>>(organizerSecret);
    require computedKey == organizerPublicKey "Unauthorized: caller is not contract organizer";

    // Assert commitment non-empty
    require commitment != pad(32, "0") "Invalid member commitment";

    // Insert commitment into on-chain allowedCommitments Map ledger
    allowedCommitments.insert(commitment, true);
    memberCount = memberCount + 1;
}

// Circuit 3: Verify Private Membership Access and Disclose Unlinkable Nullifier
export circuit verifyAccess(witness: MemberWitness, domainSeparator: Bytes<32>): Bytes<32> {
    // 1. Assert non-empty member secret & salt
    require witness.secret != pad(32, "0") "Invalid member secret key";
    require witness.salt != pad(32, "0") "Invalid member salt";

    // 2. Compute member commitment from witness secret & salt
    const memberCommitment = persistent_hash<[Bytes<32>, Bytes<32>]>([witness.secret, witness.salt]);
    
    // 3. Enforce membership constraint against on-chain allowedCommitments Map ledger
    require allowedCommitments.member(memberCommitment) "Membership verification failed: Commitment not found in allowlist";

    // 4. Compute unique, unlinkable nullifier: hash(secret, domainSeparator)
    const nullifier = persistent_hash<[Bytes<32>, Bytes<32>]>([witness.secret, domainSeparator]);

    // 5. Enforce nullifier uniqueness constraint against on-chain usedNullifiers Map ledger
    require !usedNullifiers.member(nullifier) "Double access rejected: Nullifier has already been claimed";

    // 6. Record nullifier on-chain to prevent duplicate access claims
    usedNullifiers.insert(nullifier, true);

    // 7. Increment verified access counter on ledger
    verificationCount = verificationCount + 1;

    // 8. Disclose and return derived nullifier to public state
    return disclose(nullifier);
}
